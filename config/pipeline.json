    {"tag": "llama-3.1-8b", "backend": "openrouter", "model": "meta-llama/llama-3.1-8b-instruct", "token_factor_estimate": 1.6},
    {"tag": "qwen-2.5-7b", "backend": "openrouter", "model": "qwen/qwen-2.5-7b-instruct", "token_factor_estimate": 1.55}
  ],
  "ollama_url": "http://localhost:11434",
  "openrouter_url": "https://openrouter.ai/api/v1",
  "openrouter_api_key_env": "OPENROUTER_API_KEY",
