    "RegisteredApplications": "RegisteredApplications",
    "OneDrive": "OneDrive|OneDrive\\.exe",
    "exe": "\\b[A-Za-z0-9_\\\\:.]+\\.exe\\b",
    "4616-without-regex": "4616 /",
