PREFIX ord2i: <https://example.org/thesis-ord2i#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Q14 TEMPLATE: pencarian teks literal (CONTAINS) pada pesan atau display_name. Parameter ?needle diikat dari luar.
SELECT ?event ?file ?row ?ts_raw ?tsd ?msg ?disp WHERE {
  ?event a ord2i:Event ; ord2i:hasSourceFile ?file ; ord2i:hasRowInFile ?row ; ord2i:hasTimestampRaw ?ts_raw ; ord2i:hasTimestampDescription ?tsd ;
         ord2i:hasMessage ?msg ; ord2i:hasDisplayName ?disp .
  FILTER(CONTAINS(?msg, ?needle) || CONTAINS(?disp, ?needle))
}
