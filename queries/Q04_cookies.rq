PREFIX ord2i: <https://example.org/thesis-ord2i#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Q04 Cookie per domain: jumlah event, waktu pertama/terakhir.
SELECT ?domain (COUNT(?event) AS ?n) (MIN(?ts) AS ?first) (MAX(?ts) AS ?last) WHERE {
  ?event ord2i:hasObject ?c . ?c a ord2i:Cookie ; ord2i:hasDomain ?domain .
  OPTIONAL { ?event ord2i:hasTimestamp ?ts }
} GROUP BY ?domain ORDER BY DESC(?n) ?domain
