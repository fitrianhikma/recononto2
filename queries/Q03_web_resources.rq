PREFIX ord2i: <https://example.org/thesis-ord2i#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Q03 Sumber daya web: kueri pencarian dan entri cache (SKL WebResource).
SELECT ?event ?ts ?type ?url ?host ?query WHERE {
  ?event ord2i:hasObject ?w ; ord2i:hasEventType ?type . ?w a ord2i:WebResource ; ord2i:hasURL ?url .
  OPTIONAL { ?w ord2i:hasHost ?host } OPTIONAL { ?w ord2i:hasSearchQuery ?query } OPTIONAL { ?event ord2i:hasTimestamp ?ts }
} ORDER BY ?ts ?url
