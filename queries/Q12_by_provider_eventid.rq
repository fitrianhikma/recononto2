PREFIX ord2i: <https://example.org/thesis-ord2i#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Q12 TEMPLATE: event log menurut (provider, Event ID). Parameter ?provider dan ?eid diikat dari luar (initBindings).
SELECT ?event ?file ?row ?ts_raw ?tsd ?msg ?disp WHERE {
  ?event a ord2i:EventLogEntry ; ord2i:hasProvider ?provider ; ord2i:hasEventID ?eid ;
         ord2i:hasSourceFile ?file ; ord2i:hasRowInFile ?row ; ord2i:hasTimestampRaw ?ts_raw ; ord2i:hasTimestampDescription ?tsd ; ord2i:hasMessage ?msg ; ord2i:hasDisplayName ?disp .
}
